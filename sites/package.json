{
  "name": "apexfission-carddetector-doc-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs",
    "build": "cd .. && android-repo-docs build --check",
    "dev": "cd .. && android-repo-docs serve",
    "check": "npm test && npm run build && npm run test:output",
    "test:output": "node scripts/tests/output.mjs"
  }
}
